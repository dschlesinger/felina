#!/bin/bash -l
#$ -N foundation-representations
#$ -j y
#$ -o foundation_representations.qlog
#$ -l h_rt=1:00:00
#$ -l gpus=1
#$ -l gpu_c=9.0               # keep: older GPUs lack kernels for our torch build
#$ -pe omp 4

cd "$SGE_O_WORKDIR"

# The venv lives in the repo, so activate it after the cd above.
source .venv/bin/activate

# Embeds train+test with every pretrained encoder and every fine-tune that is not cached yet. Extra args pass
# through, e.g. qsub scripts/foundation_representations.qsub --model unimol --dataset tdc_hlm
foundation-model embed "$@"
